{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "offline-replay",
      "version": "1"
    },
    "entries": [
      {
        "request": {
          "method": "GET",
          "url": "https://fixture.local/packing.html",
          "headers": []
        },
        "response": {
          "status": 200,
          "headers": [
            {
              "name": "Content-Type",
              "value": "text/html"
            }
          ],
          "content": {
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>Packing list</title>\n  </head>\n  <body>\n    <h1>Packing list</h1>\n    <form id=\"add-form\">\n      <label for=\"item\">Item</label>\n      <input id=\"item\" name=\"item\" type=\"text\" autocomplete=\"off\" />\n      <button type=\"submit\">Add</button>\n    </form>\n    <ul id=\"list\"></ul>\n    <div style=\"height: 2400px\"></div>\n    <p id=\"bottom\">Bottom marker</p>\n    <script>\n      document.getElementById(\"add-form\").addEventListener(\"submit\", (event) => {\n        event.preventDefault();\n        const input = document.getElementById(\"item\");\n        const text = input.value.trim();\n        if (!text) return;\n        const item = document.createElement(\"li\");\n        item.textContent = text;\n        document.getElementById(\"list\").appendChild(item);\n        input.value = \"\";\n      });\n    </script>\n  </body>\n</html>\n"
          }
        }
      }
    ]
  }
}
